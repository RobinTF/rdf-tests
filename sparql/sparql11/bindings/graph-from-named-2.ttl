@prefix rs:      <http://www.w3.org/2001/sw/DataAccess/tests/result-set#> .

[]  a rs:ResultSet ;
    rs:resultVariable "g" , "x" ;
    rs:solution [ rs:binding [ rs:value <data01.ttl> ; rs:variable "g" ] ;
                  rs:binding [ rs:value "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; rs:variable "x" ]
                ] .
