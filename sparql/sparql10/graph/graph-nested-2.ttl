@prefix rs:      <http://www.w3.org/2001/sw/DataAccess/tests/result-set#> .

[]  a rs:ResultSet ;
    rs:resultVariable "s" , "o" ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s1> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o1> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s1> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o1> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s2> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o2> ; rs:variable "o" ]
                ] ;
    rs:solution [ rs:binding [ rs:value <http://example.com/s2> ; rs:variable "s" ] ;
                  rs:binding [ rs:value <http://example.com/o2> ; rs:variable "o" ]
                ] .
